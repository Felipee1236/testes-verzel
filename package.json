{
  "name": "teste-qa-verzel",
  "version": "1.0.0",
  "private": true,
  "description": "Testes automatizados da entrega VZS-142 (cupom de desconto e frete grátis) da Verzel Store com Playwright",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
